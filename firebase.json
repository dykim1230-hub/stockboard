{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "Procfile",
      "main.py",
      "requirements.txt",
      ".gitignore",
      ".python-version",
      "test_news.py",
      "test_digest_cron.py",
      "docs/**",
      ".venv/**",
      "venv/**",
      "env/**",
      "__pycache__/**",
      ".git/**",
      "*.pyc"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
